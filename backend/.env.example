DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
FRONTEND_ORIGIN=http://localhost:3000
APP_NAME=Exicom Order Form Service
# Legacy shared-password gate — no longer used to protect anything, kept only
# so old code referencing it doesn't crash. Safe to leave as-is.
ADMIN_PASSWORD=change-me

# ---- Auth (JWT) --------------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   openssl rand -hex 32
# CHANGE THIS — do not ship the default in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# OTP behaviour
OTP_EXPIRES_MINUTES=10
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15

# ---- SMTP (generic — works with any mailbox that exposes standard SMTP) --
# Plain SMTP only. No paid email API, no billing/credit card required —
# just point this at a real mailbox you control.
#
# Example — Gmail (requires a 16-character "App Password", not your normal
# Gmail password: Google Account -> Security -> 2-Step Verification -> App passwords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   FROM_EMAIL=youraddress@gmail.com
#
# Example — Outlook / Microsoft 365 (also needs an App Password if MFA is on):
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@yourcompany.com
#   SMTP_PASSWORD=your-app-or-mailbox-password
#   FROM_EMAIL=youraddress@yourcompany.com
#
# Example — a generic company/organization mailbox (ask IT for these 4 values):
#   SMTP_HOST=mail.yourcompany.com
#   SMTP_PORT=587
#   SMTP_USER=noreply@yourcompany.com
#   SMTP_PASSWORD=the-mailbox-password
#   FROM_EMAIL=noreply@yourcompany.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=

# ---- Default admin account ----------------------------------------------
# Seeded once, only if the `users` table is empty. Use this to log in for the
# very first time and create everyone else via the Users tab. Change the
# password after first login if you like (there's no forced-change flow yet).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=you@yourcompany.com
DEFAULT_ADMIN_PASSWORD=change-me-strong-password
DEFAULT_ADMIN_FULL_NAME=Administrator
